# 잔별을 만든 사람에게 보내는 편지 — 받을 곳 (둘 중 하나만 채워도 됩니다)
#
# 1) 추천: 폼 수신 서비스(예: Formspree)에서 폼을 만들고 받은 주소를 넣으세요.
#    편지가 JSON으로 POST 되고, 서비스가 메일로 전달해 줍니다.
#    배포할 때는 호스팅(Vercel·Netlify 등)의 환경 변수에도 같은 이름으로 넣어야 합니다.
VITE_LETTER_ENDPOINT=

# 2) 위 주소가 없을 때: 사용자의 메일 앱을 열어 이 주소로 보내게 합니다.
VITE_LETTER_EMAIL=

# 둘 다 비어 있으면 배포된 서비스에서는 '편지 쓰기' 입구가 보이지 않습니다.
# (npm run dev 에서는 흐름 확인용으로 보이고, 이 브라우저에만 저장됩니다)
