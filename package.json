{
  "name": "janbyeol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "잔별 — 사소한 하루가 별이 되어 떠오르는 3D 감성 소셜 아카이빙",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "brand": "python3 scripts/make-brand-images.py",
    "card": "node scripts/lib/card.mjs",
    "ig:dry": "DRY_RUN=1 node scripts/daily-instagram.mjs",
    "app:build": "vite build && cap sync",
    "app:android": "npm run app:build && cap open android",
    "app:ios": "npm run app:build && cap open ios",
    "app:patch": "node scripts/cap-patch.mjs",
    "app:assets": "capacitor-assets generate --assetPath resources --android --ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.117.0",
    "mp4-muxer": "5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.3",
    "@napi-rs/canvas": "^0.1.60",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
